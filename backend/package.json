{
  "name": "@email-soc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "email:rescore": "tsx scripts/rescore-existing-email-alerts.ts",
    "ai:train": "tsx scripts/train-url-ai.ts",
    "ai:train:von": "python scripts/train-von-url-ai.py",
    "ai:train:von-ngram": "python scripts/train-von-ngram-url-ai.py",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --ignore-pattern \"src/**/*.spec.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/throttler": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "adm-zip": "^0.5.17",
    "csv-parse": "^6.2.1",
    "eslint": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
